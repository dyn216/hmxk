# 慢性病管理系统后端配置文件模板
# 复制此文件为 .env 并根据实际环境修改配置

# ==================== 应用基础配置 ====================
# 应用名称
APP_NAME=慢性病管理小程序后端API

# 应用版本
APP_VERSION=1.0.0

# 调试模式 (开发环境: true, 生产环境: false)
DEBUG=false


# ==================== 服务器配置 ====================
# 服务器监听地址
HOST=0.0.0.0

# 服务器监听端口
PORT=8000


# ==================== 数据库配置 ====================
# 数据库连接URL
# SQLite (开发环境):
DATABASE_URL=sqlite:///./chronic_disease.db

# MySQL (生产环境示例):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/chronic_disease

# PostgreSQL (生产环境示例):
# DATABASE_URL=postgresql://username:password@localhost:5432/chronic_disease


# ==================== JWT认证配置 ====================
# JWT密钥 (生产环境必须修改为强密码)
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT算法
JWT_ALGORITHM=HS256

# JWT令牌过期时间 (分钟)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080


# ==================== CORS配置 ====================
# 允许的跨域来源 (生产环境应配置具体域名，多个用逗号分隔)
# 开发环境:
CORS_ORIGINS=*

# 生产环境示例:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com


# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# 日志文件最大大小 (字节)
LOG_MAX_BYTES=10485760

# 日志文件备份数量
LOG_BACKUP_COUNT=5


# ==================== 文件上传配置 ====================
# 文件上传最大大小 (字节)
UPLOAD_MAX_SIZE=10485760

# 允许的文件扩展名 (逗号分隔)
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf

# 文件上传目录
UPLOAD_DIR=uploads


# ==================== 视频问诊配置 ====================
# 医生 WebRTC 推流基础地址，例如：webrtc://10.12.28.32/live
VIDEO_PUSH_BASE_URL=

# 医生 WebRTC 拉流基础地址，例如：webrtc://10.12.28.32/live
VIDEO_PLAY_BASE_URL=

# SRS/RTC HTTP API 基础地址，例如：http://10.12.28.32:1985
VIDEO_RTC_API_BASE_URL=

# 患者小程序 RTMP 推流基础地址，例如：rtmp://10.12.28.32/live
VIDEO_RTMP_PUSH_BASE_URL=

# 患者小程序 RTMP 拉流基础地址，例如：rtmp://10.12.28.32/live
VIDEO_RTMP_PLAY_BASE_URL=


# ==================== AI 健康助手 (MiMo) ====================
# 小米 MiMo OpenAI 兼容 API 密钥（必填，否则 AI 功能不可用）
MIMO_API_KEY=

# MiMo API 基础地址（默认即可）
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# 使用的模型名称
MIMO_MODEL=mimo-v2.5-pro

# 单次请求超时时间（秒）
MIMO_TIMEOUT=60

# 单次回复最大 token 数
MIMO_MAX_COMPLETION_TOKENS=1024

# 多轮对话上下文保留的最大历史消息数
MIMO_HISTORY_WINDOW=12

# 测量建议默认拉取最近 N 天的历史数据
MIMO_MEASUREMENT_DAYS=7


# ==================== 数据库备份配置 ====================
# 备份文件存储目录
BACKUP_DIR=backups

# 备份文件保留天数
BACKUP_RETENTION_DAYS=30
