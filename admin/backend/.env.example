# 慢性病管理系统后端配置文件模板
# 复制此文件为 .env 并根据实际环境修改配置

# ==================== 应用基础配置 ====================
# 应用名称
APP_NAME=慢性病管理小程序后端API

# 应用版本
APP_VERSION=1.0.0

# 调试模式 (开发环境: true, 生产环境: false)
DEBUG=false


# ==================== 服务器配置 ====================
# 服务器监听地址
HOST=0.0.0.0

# 服务器监听端口
PORT=8000


# ==================== 数据库配置 ====================
# 数据库连接URL
# SQLite (开发环境):
DATABASE_URL=sqlite:///./chronic_disease.db

# MySQL (生产环境示例):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/chronic_disease

# PostgreSQL (生产环境示例):
# DATABASE_URL=postgresql://username:password@localhost:5432/chronic_disease


# ==================== JWT认证配置 ====================
# JWT密钥 (生产环境必须修改为强密码)
JWT_SECRET_KEY=your-secret-key-change-in-production

# JWT算法
JWT_ALGORITHM=HS256

# JWT令牌过期时间 (分钟)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080


# ==================== CORS配置 ====================
# 允许的跨域来源 (生产环境应配置具体域名，多个用逗号分隔)
# 开发环境:
CORS_ORIGINS=*

# 生产环境示例:
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com


# ==================== 日志配置 ====================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=logs/app.log

# 日志文件最大大小 (字节)
LOG_MAX_BYTES=10485760

# 日志文件备份数量
LOG_BACKUP_COUNT=5


# ==================== 文件上传配置 ====================
# 文件上传最大大小 (字节)
UPLOAD_MAX_SIZE=10485760

# 允许的文件扩展名 (逗号分隔)
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.pdf

# 文件上传目录
UPLOAD_DIR=uploads


# ==================== 数据库备份配置 ====================
# 备份文件存储目录
BACKUP_DIR=backups

# 备份文件保留天数
BACKUP_RETENTION_DAYS=30
