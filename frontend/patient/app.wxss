/* =============================================================
   诊室手记 / Clinical Notebook — 患者端全局令牌
   ============================================================= */
page {
  /* —— Surface —— */
  --paper:        #FFFEFA;
  --paper-soft:   #FBF8F1;
  --paper-deep:   #F4EFE3;
  --paper-tint:   #F8F3E6;
  --hairline:     #E8E1D4;
  --hairline-soft:#EFE9DC;

  /* —— Ink —— */
  --ink:          #0E1E26;
  --ink-soft:     #4F5961;
  --ink-mute:     #8E929A;
  --ink-faint:    #B6B6B0;

  /* —— Brand —— */
  --sage:         #3F7D6E;
  --sage-deep:    #2C5A52;
  --sage-soft:    #E1ECE6;
  --sage-tint:    #EFF4F0;

  /* —— Status —— */
  --coral:        #C75D4F;
  --coral-soft:   #F8E5DF;
  --amber:        #C0894E;
  --amber-soft:   #F4E8D2;
  --jade:         #4F8C68;
  --jade-soft:    #E2EFE5;

  /* —— Legacy aliases for older pages —— */
  --primary:      #3F7D6E;
  --primary-color:#3F7D6E;
  --success:      #4F8C68;
  --success-color:#4F8C68;
  --warning:      #C0894E;
  --warning-color:#C0894E;
  --danger:       #C75D4F;
  --danger-color: #C75D4F;
  --bg-color:     #FBF8F1;
  --white:        #FFFEFA;
  --text-color:   #0E1E26;
  --text-main:    #0E1E26;
  --text-regular: #4F5961;
  --text-secondary:#4F5961;
  --text-sub:     #8E929A;
  --text-light:   #B6B6B0;
  --border-color: #E8E1D4;
  --border-radius:24rpx;
  --shadow:       0 12rpx 36rpx rgba(14, 30, 38, 0.06);
  --screen-max:   430px;

  background-color: var(--paper-soft);
  color: var(--ink);
  font-family: "PingFang SC", "HarmonyOS Sans SC", "Microsoft YaHei",
               -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

/* —— Reset —— */
view, text, button, input, textarea, image {
  box-sizing: border-box;
}

button {
  background: transparent;
  padding: 0;
}

button::after {
  border: none;
}

/* =============================================================
   Layout primitives
   ============================================================= */
.container {
  width: 100%;
  max-width: var(--screen-max);
  min-height: 100vh;
  margin-left: auto;
  margin-right: auto;
  padding-bottom: 200rpx;
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  background: var(--paper-soft);
}

.scroll-content {
  width: 100%;
  max-width: var(--screen-max);
  margin-left: auto;
  margin-right: auto;
  padding: 24rpx 28rpx 220rpx;
  padding-bottom: calc(220rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

/* —— Page header (in-page; native nav handled by app.json) —— */
.page-head {
  width: 100%;
  max-width: var(--screen-max);
  margin-left: auto;
  margin-right: auto;
  padding: 32rpx 32rpx 8rpx;
  background: var(--paper-soft);
}

.page-head .eyebrow {
  display: inline-block;
  margin-bottom: 16rpx;
  padding: 6rpx 16rpx;
  border: 1rpx solid var(--hairline);
  border-radius: 999rpx;
  background: var(--paper);
  color: var(--ink-mute);
  font-size: 20rpx;
  letter-spacing: 0.4em;
  text-transform: uppercase;
}

.page-head .title {
  display: block;
  font-size: 56rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  line-height: 1.1;
  color: var(--ink);
}

.page-head .subtitle {
  display: block;
  margin-top: 14rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.7;
}

/* =============================================================
   Header bar (custom in-page header — for non-tab pages)
   ============================================================= */
.header {
  width: 100%;
  max-width: var(--screen-max);
  margin-left: auto;
  margin-right: auto;
  background: var(--paper);
  border-bottom: 1rpx solid var(--hairline);
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.header .title,
.header .header-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -0.5rpx;
}

.header-icon {
  font-size: 38rpx;
  color: var(--ink-soft);
}

/* =============================================================
   Section title
   ============================================================= */
.section-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 4rpx 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.5rpx;
  color: var(--ink);
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 3rpx;
  background: var(--sage);
}

.section-title .section-sub,
.section-title small {
  margin-left: auto;
  color: var(--ink-mute);
  font-size: 24rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.section-title::before {
  flex-shrink: 0;
}

/* When the section-title contains the brand bar, suppress the bar */
.section-title.plain::before { display: none; }

/* =============================================================
   Section block (legacy support)
   ============================================================= */
.section {
  background: var(--paper);
  border: 1rpx solid var(--hairline);
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin: 0 24rpx 20rpx;
  box-shadow: var(--shadow);
}

/* =============================================================
   Card
   ============================================================= */
.card {
  background: var(--paper);
  border: 1rpx solid var(--hairline);
  border-radius: var(--border-radius);
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow);
  max-width: 100%;
}

/* =============================================================
   Generic buttons
   ============================================================= */
.btn-primary,
.btn-secondary,
.btn-danger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  border: 2rpx solid transparent;
  line-height: 1;
  box-sizing: border-box;
  max-width: 100%;
}

.btn-primary {
  background: var(--sage);
  color: var(--paper);
  box-shadow: inset 0 0 0 1rpx rgba(255, 254, 250, 0.18);
}

.btn-primary:active {
  background: var(--sage-deep);
}

.btn-secondary {
  background: var(--paper);
  color: var(--ink);
  border-color: var(--hairline);
}

.btn-secondary:active {
  background: var(--sage-tint);
  border-color: var(--sage);
  color: var(--sage-deep);
}

.btn-danger {
  background: var(--paper);
  color: var(--coral);
  border-color: rgba(199, 93, 79, 0.35);
}

.btn-danger:active {
  background: var(--coral);
  color: var(--paper);
  border-color: var(--coral);
}

/* —— Mini buttons —— */
.btn-mini {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  min-width: 0;
}

.btn-mini.btn-primary {
  height: auto;
  padding: 14rpx 28rpx;
}

.btn-mini.btn-outline {
  background: var(--paper);
  color: var(--sage-deep);
  border-color: var(--sage);
}

.btn-mini.btn-success {
  background: var(--jade);
  color: var(--paper);
}

/* Active feedback */
button:active { opacity: 0.92; }

/* =============================================================
   Form
   ============================================================= */
.form-item {
  margin-bottom: 32rpx;
}

.form-item .label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-mute);
}

.form-item .input,
.form-item .textarea {
  width: 100%;
  padding: 26rpx 28rpx;
  background: var(--paper-soft);
  border: 1rpx solid var(--hairline);
  border-radius: 20rpx;
  color: var(--ink);
  font-size: 30rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.form-item .input:focus {
  border-color: var(--sage);
  background: var(--paper);
}

/* =============================================================
   Status badge
   ============================================================= */
.status-badge,
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.04em;
  border: 1rpx solid transparent;
}

.status-badge.pending,
.tag-orange {
  color: var(--amber);
  background: var(--amber-soft);
  border-color: rgba(192, 137, 78, 0.3);
}

.status-badge.approved,
.status-badge.paid,
.status-badge.completed,
.tag-green {
  color: var(--jade);
  background: var(--jade-soft);
  border-color: rgba(79, 140, 104, 0.28);
}

.status-badge.rejected,
.status-badge.cancelled,
.tag-red {
  color: var(--coral);
  background: var(--coral-soft);
  border-color: rgba(199, 93, 79, 0.32);
}

.tag-blue {
  color: var(--sage-deep);
  background: var(--sage-soft);
  border-color: rgba(63, 125, 110, 0.25);
}

/* =============================================================
   Empty state
   ============================================================= */
.empty,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
  color: var(--ink-mute);
  text-align: center;
}

.empty-icon,
.icon-empty {
  width: 144rpx;
  height: 144rpx;
  margin-bottom: 24rpx;
  border-radius: 50%;
  background: var(--paper-deep);
  color: var(--ink-mute);
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty text,
.empty-text {
  font-size: 26rpx;
  color: var(--ink-mute);
}

/* =============================================================
   Utility icons
   ============================================================= */
.icon-avatar,
.icon-logo,
.icon-product,
.icon-empty,
.icon-device,
.icon-status,
.icon-small,
.icon-service,
.goods-icon,
.chart-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
  color: var(--paper);
  background: linear-gradient(140deg, var(--sage) 0%, var(--sage-deep) 100%);
  font-weight: 600;
}

.icon-avatar {
  border-radius: 50%;
  font-family: "Source Han Serif SC", "Songti SC", Georgia, serif;
}

.icon-logo {
  border-radius: 28rpx;
  font-size: 56rpx;
}

.icon-product {
  color: var(--sage-deep);
  background: var(--sage-tint);
  border: 1rpx solid var(--hairline);
  border-radius: 16rpx;
  font-size: 36rpx;
}

.icon-device,
.icon-status {
  border-radius: 18rpx;
}

.icon-small {
  color: var(--sage-deep);
  background: var(--sage-soft);
  border-radius: 50%;
  font-size: 22rpx;
}

.icon-service {
  color: var(--sage-deep);
  background: var(--sage-tint);
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  font-size: 30rpx;
}

.cart-text-icon,
.delete-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: inherit;
  line-height: 1;
}

/* =============================================================
   Helpers
   ============================================================= */
input:focus {
  border-color: var(--sage) !important;
  outline: none;
}

.text-center { text-align: center; }
.text-right  { text-align: right; }

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer,
.buy-bar {
  max-width: var(--screen-max);
  margin-left: auto;
  margin-right: auto;
}

@media (max-width: 360px) {
  page {
    font-size: 26rpx;
  }

  .container {
    padding-bottom: 180rpx;
    padding-bottom: calc(180rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  }

  .scroll-content {
    padding-left: 22rpx;
    padding-right: 22rpx;
    padding-bottom: 200rpx;
    padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
    padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  }

  .page-head {
    padding-left: 24rpx;
    padding-right: 24rpx;
  }

  .page-head .title {
    font-size: 50rpx;
    letter-spacing: -0.6rpx;
  }

  .page-head .subtitle {
    font-size: 24rpx;
  }

  .card,
  .section {
    padding: 26rpx;
    border-radius: 22rpx;
  }

  .btn-primary,
  .btn-secondary,
  .btn-danger {
    height: 80rpx;
    padding-left: 28rpx;
    padding-right: 28rpx;
    font-size: 26rpx;
  }

  .btn-mini {
    padding: 12rpx 20rpx;
    font-size: 22rpx;
  }
}
