.login-container {
  min-height: 100vh;
  padding: 80rpx 56rpx 60rpx;
  background: var(--paper-soft);
  position: relative;
  overflow: hidden;
}

.login-container::before {
  content: "";
  position: absolute;
  top: -160rpx;
  right: -120rpx;
  width: 480rpx;
  height: 480rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(63, 125, 110, 0.16), transparent 65%);
  pointer-events: none;
}

.login-container::after {
  content: "";
  position: absolute;
  bottom: -180rpx;
  left: -140rpx;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(199, 93, 79, 0.12), transparent 65%);
  pointer-events: none;
}

.login-header {
  position: relative;
  margin-bottom: 80rpx;
  padding-top: 40rpx;
}

.login-header .brand-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.login-header .logo {
  width: 96rpx;
  height: 96rpx;
  margin-right: 22rpx;
  border-radius: 24rpx;
  background: var(--paper);
  box-shadow: 0 16rpx 36rpx rgba(63, 125, 110, 0.22);
}

.login-header .title {
  display: inline-block;
  font-family: "Source Han Serif SC", "Songti SC", Georgia, serif;
  font-size: 60rpx;
  font-weight: 500;
  letter-spacing: -1rpx;
  line-height: 1.1;
  color: var(--ink);
}

.login-header .subtitle {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  letter-spacing: 0.18em;
  color: var(--ink-mute);
  text-transform: uppercase;
}

.login-form {
  position: relative;
  background: var(--paper);
  border: 1rpx solid var(--hairline);
  border-radius: 36rpx;
  padding: 56rpx 44rpx 48rpx;
  box-shadow: 0 24rpx 48rpx rgba(14, 30, 38, 0.08);
}

.privacy-card {
  margin-bottom: 36rpx;
  padding: 28rpx;
  background: rgba(44, 90, 82, 0.06);
  border: 1rpx solid rgba(44, 90, 82, 0.14);
  border-radius: 24rpx;
}

.privacy-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.privacy-desc {
  display: block;
  margin-bottom: 22rpx;
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.7;
}

.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  font-size: 24rpx;
  line-height: 1.8;
}

.agreement-text {
  color: var(--ink-soft);
}

.agreement-link {
  color: var(--sage-deep);
  font-weight: 700;
}

.login-form .form-item {
  position: relative;
  margin-bottom: 36rpx;
}

.login-form .label {
  display: block;
  margin-bottom: 14rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-mute);
}

.login-form .input {
  width: 100%;
  height: 96rpx;
  padding: 0 128rpx 0 32rpx;
  background: var(--paper-soft);
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.login-form .input:focus {
  border-color: var(--sage);
  background: var(--paper);
}

.toggle-password {
  position: absolute;
  right: 28rpx;
  bottom: 32rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--sage-deep);
}

.login-btn {
  width: 100%;
  height: 96rpx;
  margin-top: 16rpx;
  background: var(--ink);
  color: var(--paper);
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn:active { background: var(--sage-deep); }
.login-btn::after { border: none; }

.login-btn.is-disabled {
  background: #bcc8c4;
  color: rgba(255, 255, 255, 0.9);
}

.tips {
  margin-top: 36rpx;
  padding: 24rpx 28rpx;
  background: var(--paper-soft);
  border: 1rpx dashed var(--hairline);
  border-left: 6rpx solid var(--amber);
  border-radius: 18rpx;
}

.tip-text {
  display: block;
  font-family: "SF Mono", "Menlo", monospace;
  font-size: 22rpx;
  color: var(--ink-soft);
  line-height: 1.7;
  letter-spacing: 0.04em;
}

.tip-text:first-child {
  color: var(--ink);
  font-weight: 600;
}
