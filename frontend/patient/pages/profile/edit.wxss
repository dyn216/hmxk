/* 个人信息编辑页样式 */
.container { background: #f5f7fa; min-height: 100vh; padding-bottom: 20rpx; }
.header { background: #fff; padding: 30rpx; margin-bottom: 20rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #333; }
.form { background: #fff; padding: 30rpx; }
.form-item { margin-bottom: 40rpx; }
.form-item:last-child { margin-bottom: 0; }
.form-item .label { display: block; font-size: 28rpx; color: #333; margin-bottom: 16rpx; font-weight: bold; }
.form-item .input { width: 100%; height: 88rpx; line-height: 88rpx; padding: 0 24rpx; box-sizing: border-box; border: 2rpx solid #e8e8e8; border-radius: 8rpx; font-size: 28rpx; background: #fff; }
.form-item .textarea { width: 100%; min-height: 160rpx; line-height: 1.5; padding: 24rpx; box-sizing: border-box; border: 2rpx solid #e8e8e8; border-radius: 8rpx; font-size: 28rpx; background: #fff; }
.form-item .picker { width: 100%; height: 88rpx; line-height: 88rpx; padding: 0 24rpx; box-sizing: border-box; border: 2rpx solid #e8e8e8; border-radius: 8rpx; font-size: 28rpx; background: #fff; color: #333; }
.avatar-item { display: flex; align-items: center; justify-content: space-between; }
.avatar-upload { display: flex; flex-direction: column; align-items: center; }
.avatar-upload .avatar { width: 160rpx; height: 160rpx; border-radius: 50%; margin-bottom: 16rpx; }
.avatar-upload .upload-tip { font-size: 24rpx; color: #6a7cfc; }
.form-actions { display: flex; gap: 20rpx; margin-top: 60rpx; }
.btn-cancel { flex: 1; padding: 24rpx; background: #fff; color: #666; border: 2rpx solid #e8e8e8; border-radius: 8rpx; font-size: 32rpx; }
.btn-submit { flex: 1; padding: 24rpx; background: #6a7cfc; color: #fff; border-radius: 8rpx; font-size: 32rpx; border: none; }
