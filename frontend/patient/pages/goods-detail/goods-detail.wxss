.goods-images {
  height: 600rpx;
}

.goods-info {
  padding: 30rpx;
  background: #fff;
}

.goods-name {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 16rpx;
}

.goods-price {
  font-size: 48rpx;
  color: #f56c6c;
  display: block;
  margin-bottom: 30rpx;
}

.goods-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.buy-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-width: 430px;
  margin-left: auto;
  margin-right: auto;
  padding: 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
}

.buy-btn {
  background: #4a90e2;
  color: #fff;
  border-radius: 40rpx;
  box-sizing: border-box;
}

@media (max-width: 360px) {
  .goods-images {
    height: 480rpx;
  }

  .goods-info {
    padding: 24rpx 22rpx;
  }

  .goods-name {
    font-size: 32rpx;
  }

  .goods-price {
    font-size: 42rpx;
  }
}
