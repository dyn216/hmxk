/* 引入全局样式 */
@import "/styles/common.wxss";

/* 页面全局样式（参考小米运动健康绿色主调） */
.bracelet-page {
  padding: 30rpx;
  background-color: #f5f7fa;
}

/* 设备卡片 */
.device-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #38B249;
  border-radius: 12rpx;
  padding: 30rpx;
  color: #fff;
  margin-bottom: 30rpx;
}
.card-header {
  display: flex;
  align-items: center;
}
.card-header image {
  width: 80rpx;
  height: 80rpx;
  margin-right: 20rpx;
}
.device-info .device-name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 5rpx;
}
.device-info .device-status {
  font-size: 24rpx;
  opacity: 0.8;
}
.disconnect-btn {
  background-color: rgba(255, 255, 255, 0.3);
  color: #fff;
  border-radius: 20rpx;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
}
.disconnect-btn::after {
  border: none;
}

/* 数据模块 */
.data-module .data-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
  border-radius: 12rpx;
  padding: 25rpx 30rpx;
  margin-bottom: 20rpx;
}
.item-label {
  font-size: 30rpx;
  color: #333;
}
.progress-bar {
  width: 60%;
  height: 16rpx;
  background-color: #eee;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress {
  height: 100%;
  background-color: #38B249;
}
.battery-text {
  font-size: 24rpx;
  color: #38B249;
}
.color-select {
  display: flex;
  align-items: center;
}
.color-dot {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}
.color-text {
  font-size: 24rpx;
  color: #666;
  margin-right: 20rpx;
}

/* 系统升级模块 */
.upgrade-module {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-top: 30rpx;
}
.module-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.version-info view {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}
.upgrade-btn {
  background-color: #38B249;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  margin-top: 10rpx;
}
.upgrade-btn::after {
  border: none;
}

/* 使用说明模块 */
.tips-module {
  background-color: #fff8e1;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 30rpx;
}
.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #f57c00;
  margin-bottom: 10rpx;
}
.tips-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}