/* 药品列表页样式 */

.container {
  background: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 160rpx;
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 分类标签 */
.category-tabs {
  background: #fff;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.tabs-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  background: #f5f7fa;
}

.tab-item.active {
  background: #6a7cfc;
  color: #fff;
}

/* 商品列表 */
.product-list {
  padding: 0 30rpx;
}

.product-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.product-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-spec {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.prescription-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  background: #fff7e6;
  color: #faad14;
  font-size: 20rpx;
  border-radius: 4rpx;
  margin-bottom: 12rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.price {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.price::before {
  content: '¥';
  font-size: 24rpx;
}

.btn-add-cart {
  padding: 12rpx 32rpx;
  background: #6a7cfc;
  color: #fff;
  border-radius: 40rpx;
  font-size: 24rpx;
  border: none;
}

/* 购物车图标 */
.cart-icon {
  position: fixed;
  right: 30rpx;
  bottom: 100rpx;
  bottom: calc(100rpx + constant(safe-area-inset-bottom));
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  background: #6a7cfc;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(106, 124, 252, 0.4);
}

.cart-icon image {
  width: 48rpx;
  height: 48rpx;
}

@media (min-width: 431px) {
  .cart-icon {
    right: calc((100% - 430px) / 2 + 30rpx);
  }
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 18rpx;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty text {
  font-size: 28rpx;
  color: #999;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  font-size: 28rpx;
  color: #999;
}

.no-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #ccc;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
}

.cart-icon {
  position: relative;
  right: auto;
  bottom: auto;
  width: 72rpx;
  height: 72rpx;
  background: #f2f4ff;
  border-radius: 50%;
  box-shadow: none;
  flex-shrink: 0;
}

.cart-icon image {
  width: 42rpx;
  height: 42rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
}

.scroll-view {
  white-space: nowrap;
}

.tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  height: 64rpx;
  padding: 0 28rpx;
  margin-right: 20rpx;
  border-radius: 34rpx;
  background: #f5f7fa;
  color: #666;
  font-size: 26rpx;
  box-sizing: border-box;
}

.tab.active {
  background: #6a7cfc;
  color: #fff;
  font-weight: 600;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.product-card {
  position: relative;
  overflow: hidden;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.product-card .product-image {
  display: block;
  width: 100%;
  height: 260rpx;
  margin-right: 0;
  border-radius: 0;
  background: #f5f7fa;
}

.product-card .product-info {
  min-height: 230rpx;
  padding: 18rpx;
  box-sizing: border-box;
}

.product-card .product-name {
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
}

.product-card .product-spec {
  min-height: 34rpx;
  line-height: 34rpx;
}

.product-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 12rpx;
}

.price-box {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.product-card .price {
  font-size: 34rpx;
  color: #ff4d4f;
  font-weight: 700;
}

.product-card .price::before {
  content: '';
}

.sales {
  font-size: 22rpx;
  color: #999;
}

.add-cart {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f4ff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.add-cart image {
  width: 34rpx;
  height: 34rpx;
}

.tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.tag.rx {
  background: #fff7e6;
  color: #faad14;
}

@media (max-width: 360px) {
  .header {
    padding: 24rpx 22rpx;
  }

  .title {
    font-size: 32rpx;
  }

  .category-tabs {
    padding: 18rpx 22rpx;
  }

  .tab-item,
  .tab {
    padding-left: 22rpx;
    padding-right: 22rpx;
    font-size: 24rpx;
  }

  .product-list,
  .product-grid {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .product-grid {
    gap: 14rpx;
  }

  .product-item {
    padding: 20rpx;
  }

  .product-image {
    width: 150rpx;
    height: 150rpx;
    margin-right: 18rpx;
  }

  .product-card .product-image {
    height: 220rpx;
  }

  .product-card .product-info {
    min-height: 208rpx;
    padding: 16rpx;
  }

  .product-name,
  .product-card .product-name {
    font-size: 26rpx;
  }

  .product-spec {
    font-size: 22rpx;
  }

  .price,
  .product-card .price {
    font-size: 30rpx;
  }

  .btn-add-cart {
    padding: 10rpx 24rpx;
  }

  .cart-icon {
    right: 22rpx;
    width: 88rpx;
    height: 88rpx;
  }
}
