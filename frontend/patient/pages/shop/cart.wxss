/* 购物车页样式 */

.container {
  background: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.header {
  background: #fff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 购物车列表 */
.cart-list {
  background: #fff;
  padding: 0 30rpx;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.cart-item:last-child {
  border-bottom: none;
}

.checkbox {
  margin-right: 20rpx;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 160rpx;
}

.item-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-spec {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.btn-quantity {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #666;
  background: #fff;
}

.btn-quantity.disabled {
  color: #ccc;
  border-color: #f0f0f0;
}

.quantity {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

/* 全选和删除 */
.cart-actions {
  background: #fff;
  padding: 30rpx;
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.select-all {
  display: flex;
  align-items: center;
}

.select-all text {
  margin-left: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.btn-delete {
  padding: 12rpx 32rpx;
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 8rpx;
  font-size: 28rpx;
}

/* 底部结算栏 */
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-width: 430px;
  margin-left: auto;
  margin-right: auto;
  background: #fff;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
  z-index: 100;
}

.total-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.total-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.total-price {
  font-size: 40rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.btn-checkout {
  flex-shrink: 0;
  padding: 24rpx 60rpx;
  background: #6a7cfc;
  color: #fff;
  border-radius: 8rpx;
  font-size: 32rpx;
  border: none;
}

.btn-checkout.disabled {
  background: #ccc;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.btn-go-shop {
  padding: 20rpx 60rpx;
  background: #6a7cfc;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
}

.cart-item checkbox-group {
  margin-right: 18rpx;
  flex-shrink: 0;
}

.cart-item .product-image {
  width: 136rpx;
  height: 136rpx;
  border-radius: 10rpx;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: #f5f7fa;
}

.cart-item .product-info {
  flex: 1;
  min-width: 0;
  min-height: 136rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cart-item .product-name {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.cart-item .product-spec {
  font-size: 24rpx;
  color: #999;
}

.cart-item .product-price {
  font-size: 30rpx;
  color: #ff4d4f;
  font-weight: 700;
}

.cart-item .quantity-control {
  margin-left: 14rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 8rpx;
  overflow: hidden;
  flex-shrink: 0;
}

@media (max-width: 360px) {
  .footer {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .total-price {
    font-size: 34rpx;
  }

  .btn-checkout {
    padding: 22rpx 40rpx;
    font-size: 28rpx;
  }

  .cart-item .product-image {
    width: 112rpx;
    height: 112rpx;
    margin-right: 14rpx;
  }

  .cart-item .product-info {
    min-height: 112rpx;
  }

  .cart-item .product-name {
    font-size: 26rpx;
  }

  .cart-item .product-spec {
    font-size: 22rpx;
  }

  .cart-item .product-price {
    font-size: 28rpx;
  }
}

.btn-minus,
.btn-plus {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  color: #666;
  background: #fff;
  font-size: 30rpx;
}

.quantity-input {
  width: 56rpx;
  height: 44rpx;
  min-height: 44rpx;
  text-align: center;
  font-size: 24rpx;
  color: #333;
  border-left: 2rpx solid #e8e8e8;
  border-right: 2rpx solid #e8e8e8;
  box-sizing: border-box;
}

.cart-item .btn-delete {
  width: 44rpx;
  height: 44rpx;
  padding: 0;
  margin-left: 14rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cart-item .btn-delete image {
  width: 36rpx;
  height: 36rpx;
}
