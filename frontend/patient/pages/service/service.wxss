/* 联系客服页面样式 */
.container {
  padding: 20rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.service-card {
  background: white;
  border-radius: 10rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.service-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.contact-info {
  flex: 1;
}

.contact-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.contact-value {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}

.service-hours {
  background: #f8f9fa;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.hours-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.hours-text {
  font-size: 26rpx;
  color: #999;
  line-height: 1.5;
}