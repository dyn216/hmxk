/* 引入全局样式 */
@import "/styles/common.wxss";

/* 页面特有样式 */
.container {
  min-height: 100vh;
  background: var(--bg-color);
}

/* 导航栏已在common.wxss中定义 */

.search-card {
  padding: 20rpx 24rpx;
}

.search-input {
  height: 72rpx;
  padding: 0 28rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.department-tabs {
  margin-bottom: 24rpx;
}

.tabs-scroll {
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #5f6b72;
  font-size: 26rpx;
  border: 1rpx solid #e7ece8;
}

.tab-item.active {
  background: #2C5A52;
  color: #fff;
  border-color: #2C5A52;
}

.selected-doctor {
  padding: 20rpx 20rpx 20rpx;
}

.selected-label {
  padding: 0 24rpx 16rpx;
  color: #2C5A52;
  font-size: 24rpx;
  font-weight: 600;
}

.doctor-card {
  align-items: flex-start;
  gap: 24rpx;
  padding: 30rpx;
  margin: 18rpx 20rpx;
  border: 1rpx solid #e7ece8;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 34rpx rgba(16, 34, 31, 0.08);
  transition: all 0.2s ease;
}

.doctor-card:last-child {
  border-bottom: 1rpx solid #e7ece8;
}

.selected-doctor .doctor-card {
  margin: 0;
}

.doctor-avatar {
  width: 104rpx;
  height: 104rpx;
  box-shadow: 0 10rpx 26rpx rgba(44, 90, 82, 0.2);
}

.doctor-card:active {
  transform: scale(0.98);
}

.doctor-card.is-selected,
.selected-card {
  background: linear-gradient(135deg, #f1faf5, #ffffff);
  border-color: rgba(44, 90, 82, 0.28);
}

.doctor-name {
  font-size: 34rpx;
  line-height: 1.25;
  margin-bottom: 10rpx;
}

.doctor-meta {
  margin-top: 8rpx;
  color: #7b8582;
  font-size: 24rpx;
  line-height: 1.45;
}

.doctor-desc {
  margin-top: 8rpx;
  color: #9aa19e;
  font-size: 24rpx;
  line-height: 1.5;
  white-space: normal;
}

.doctor-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 14rpx;
  color: #68726f;
  font-size: 22rpx;
}

.doctor-stats text {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f8f6;
}

.status-tag {
  margin-top: 14rpx;
  margin-right: 8rpx;
}

.doctor-actions {
  min-width: 128rpx;
  gap: 14rpx;
}

.doctor-actions .btn-mini {
  min-width: 116rpx;
  height: 60rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  line-height: 60rpx;
  text-align: center;
}

.empty-card {
  padding: 72rpx 32rpx;
  text-align: center;
}

.empty-icon {
  margin: 0 auto 20rpx;
}

.empty-text {
  color: #8e929a;
  font-size: 28rpx;
}

/* 服务介绍优化 */
.feature-item {
  transition: all 0.2s ease;
}

.feature-item:active {
  background: #f8f8f8;
}

.feature-icon {
  background: linear-gradient(135deg, #e8f3ff 0%, #deeeff 100%);
  border: 2rpx solid #d0e7ff;
}

@media (max-width: 360px) {
  .search-card {
    padding: 16rpx 18rpx;
  }

  .search-input {
    height: 68rpx;
    font-size: 26rpx;
  }

  .tab-item {
    padding: 10rpx 22rpx;
    font-size: 24rpx;
  }

  .selected-label {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .doctor-meta,
  .doctor-stats {
    font-size: 22rpx;
  }

  .empty-card {
    padding: 56rpx 24rpx;
  }
}
