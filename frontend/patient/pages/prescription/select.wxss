/* 处方选择页样式 */
.container { background: #f5f7fa; min-height: 100vh; padding-bottom: 140rpx; padding-bottom: calc(160rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.header { background: #fff; padding: 30rpx; margin-bottom: 20rpx; }
.title { font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 12rpx; }
.subtitle { font-size: 24rpx; color: #999; }
.prescription-list { padding: 0 30rpx; }
.prescription-item { background: #fff; border-radius: 12rpx; padding: 30rpx; margin-bottom: 20rpx; display: flex; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05); }
.prescription-item.selected { border: 2rpx solid #6a7cfc; }
.select-icon { width: 48rpx; height: 48rpx; margin-right: 20rpx; flex-shrink: 0; }
.select-icon image { width: 100%; height: 100%; }
.prescription-content { flex: 1; min-width: 0; }
.prescription-header { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.doctor-name { flex: 1; min-width: 0; font-size: 28rpx; color: #333; font-weight: bold; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.date { flex-shrink: 0; font-size: 24rpx; color: #999; }
.diagnosis { display: flex; margin-bottom: 16rpx; font-size: 28rpx; }
.diagnosis .label { color: #999; margin-right: 12rpx; }
.diagnosis .value { flex: 1; min-width: 0; color: #333; }
.medicines { margin-bottom: 16rpx; }
.medicine-count { font-size: 24rpx; color: #666; margin-bottom: 8rpx; }
.medicine-names { font-size: 24rpx; color: #999; line-height: 1.6; }
.valid-until { display: flex; font-size: 24rpx; }
.valid-until .label { color: #999; margin-right: 12rpx; }
.valid-until .value { flex: 1; min-width: 0; color: #666; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 60rpx; }
.empty image { width: 300rpx; height: 300rpx; margin-bottom: 30rpx; opacity: 0.5; }
.empty text { font-size: 28rpx; color: #999; margin-bottom: 16rpx; }
.empty .hint { font-size: 24rpx; color: #999; margin-bottom: 30rpx; }
.btn-consult { padding: 20rpx 60rpx; background: #6a7cfc; color: #fff; border-radius: 8rpx; font-size: 28rpx; border: none; }
.footer { position: fixed; bottom: 0; left: 0; right: 0; max-width: 430px; margin-left: auto; margin-right: auto; background: #fff; padding: 20rpx 30rpx; padding-bottom: calc(20rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05); z-index: 100; }
.btn-confirm { width: 100%; padding: 24rpx; background: #6a7cfc; color: #fff; border-radius: 8rpx; font-size: 32rpx; border: none; box-sizing: border-box; }
.btn-confirm:disabled { background: #ccc; }

@media (max-width: 360px) {
  .header { padding: 24rpx 22rpx; }
  .title { font-size: 32rpx; }
  .prescription-list { padding-left: 22rpx; padding-right: 22rpx; }
  .prescription-item { padding: 24rpx 22rpx; }
  .prescription-header { flex-direction: column; align-items: flex-start; gap: 6rpx; }
  .footer { padding-left: 22rpx; padding-right: 22rpx; }
  .btn-confirm { padding: 22rpx; font-size: 28rpx; }
}
