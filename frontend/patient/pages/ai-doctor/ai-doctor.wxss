page {
  background: #f2f5f1;
}

.ai-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.ai-header {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, #2c5a52 0%, #3d7a6a 100%);
  color: #fff;
}

.ai-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-weight: 600;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.ai-meta { flex: 1; }
.ai-name { font-size: 32rpx; font-weight: 600; }
.ai-sub { font-size: 22rpx; color: rgba(255, 255, 255, 0.8); margin-top: 4rpx; }
.ai-action {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  padding: 10rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 100rpx;
}

.ai-body {
  flex: 1;
  padding: 24rpx 28rpx 32rpx;
  box-sizing: border-box;
}

.loading {
  text-align: center;
  color: #8a9a8e;
  font-size: 24rpx;
  padding: 24rpx 0;
}

.bubble-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 24rpx;
}
.bubble-row.self { justify-content: flex-end; }

.bubble-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #2c5a52;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 14rpx;
  flex-shrink: 0;
}
.bubble-avatar.self {
  background: #c1a172;
  margin-left: 14rpx;
  margin-right: 0;
}

.bubble {
  max-width: 76%;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  line-height: 1.55;
  background: #fff;
  color: #1f2a26;
  box-shadow: 0 8rpx 24rpx rgba(34, 60, 53, 0.06);
  word-break: break-word;
  white-space: pre-wrap;
}
.bubble.self {
  background: #2c5a52;
  color: #fff;
  border-bottom-right-radius: 6rpx;
}
.bubble.other {
  background: #fff;
  border-bottom-left-radius: 6rpx;
}
.bubble.pending {
  color: #8a9a8e;
  font-style: italic;
}
.bubble.error {
  background: #fff5f3;
  color: #c0392b;
}
.bubble-time {
  font-size: 20rpx;
  margin-top: 8rpx;
  opacity: 0.55;
}
.bubble.self .bubble-time { color: rgba(255, 255, 255, 0.75); }

.quick-row {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(34, 60, 53, 0.05);
}
.quick-tip { font-size: 24rpx; color: #6c7d72; margin-bottom: 14rpx; }
.quick-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.quick-item {
  font-size: 24rpx;
  color: #2c5a52;
  background: #e8f1ec;
  padding: 12rpx 22rpx;
  border-radius: 100rpx;
}

.disclaimer {
  text-align: center;
  font-size: 22rpx;
  color: #8a9a8e;
  margin: 32rpx 0 12rpx;
  padding: 0 24rpx;
  line-height: 1.5;
}

.ai-input {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e3ebe4;
}
.input-box {
  flex: 1;
  background: #f2f5f1;
  border-radius: 100rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
}
.send-btn {
  margin-left: 16rpx;
  background: #2c5a52;
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 100rpx;
}
.send-btn[disabled] { opacity: 0.6; }

/* 同意弹层 */
.consent-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 32, 28, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  padding: 60rpx;
}
.consent-card {
  width: 100%;
  background: #fff;
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
}
.consent-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2a26;
  margin-bottom: 18rpx;
}
.consent-text {
  font-size: 26rpx;
  color: #4a5853;
  line-height: 1.7;
  margin-bottom: 14rpx;
}
.consent-link { color: #2c5a52; }
.consent-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 18rpx;
}
.consent-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 100rpx;
  padding: 16rpx 0;
}
.consent-btn.primary { background: #2c5a52; color: #fff; }
.consent-btn.ghost { background: #f2f5f1; color: #4a5853; }
