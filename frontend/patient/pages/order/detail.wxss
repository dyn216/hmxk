/* 订单详情页样式 */
.container { background: #f5f7fa; min-height: 100vh; padding-bottom: 140rpx; padding-bottom: calc(160rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }
.status-section { background: #fff; padding: 60rpx 30rpx; text-align: center; margin-bottom: 20rpx; }
.status-icon { width: 120rpx; height: 120rpx; margin-bottom: 20rpx; }
.status-text { font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 12rpx; }
.status-desc { font-size: 24rpx; color: #999; }
.address-section { background: #fff; padding: 30rpx; margin-bottom: 20rpx; }
.section-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 20rpx; }
.address-info { padding: 20rpx; background: #f5f7fa; border-radius: 8rpx; }
.receiver { display: flex; align-items: center; flex-wrap: wrap; gap: 8rpx 20rpx; margin-bottom: 12rpx; }
.receiver .name { font-size: 32rpx; font-weight: bold; color: #333; margin-right: 20rpx; }
.receiver .phone { font-size: 28rpx; color: #666; }
.address { font-size: 28rpx; color: #666; line-height: 1.6; }
.goods-section { background: #fff; padding: 30rpx; margin-bottom: 20rpx; }
.goods-list { margin-top: 20rpx; }
.goods-item { display: flex; margin-bottom: 24rpx; padding-bottom: 24rpx; border-bottom: 2rpx solid #f0f0f0; }
.goods-item:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: none; }
.goods-image { width: 140rpx; height: 140rpx; border-radius: 8rpx; margin-right: 20rpx; }
.goods-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: space-between; }
.goods-name { font-size: 28rpx; color: #333; margin-bottom: 8rpx; }
.goods-spec { font-size: 24rpx; color: #999; margin-bottom: 12rpx; }
.goods-bottom { display: flex; justify-content: space-between; gap: 12rpx; }
.price { font-size: 28rpx; color: #ff4d4f; font-weight: bold; }
.quantity { font-size: 24rpx; color: #999; }
.order-info-section { background: #fff; padding: 30rpx; margin-bottom: 20rpx; }
.info-row { display: flex; margin-bottom: 16rpx; font-size: 28rpx; }
.info-row:last-child { margin-bottom: 0; }
.info-row .label { color: #999; margin-right: 20rpx; }
.info-row .value { flex: 1; min-width: 0; color: #333; word-break: break-all; }
.price-section { background: #fff; padding: 30rpx; margin-bottom: 20rpx; }
.price-row { display: flex; justify-content: space-between; gap: 12rpx; margin-bottom: 20rpx; font-size: 28rpx; }
.price-row:last-child { margin-bottom: 0; }
.price-row .label { color: #666; }
.price-row .value { color: #333; }
.price-row.total { padding-top: 20rpx; border-top: 2rpx solid #f0f0f0; font-size: 32rpx; }
.price-row.total .value { color: #ff4d4f; font-weight: bold; font-size: 36rpx; }
.footer { position: fixed; bottom: 0; left: 0; right: 0; max-width: 430px; margin-left: auto; margin-right: auto; background: #fff; padding: 20rpx 30rpx; padding-bottom: calc(20rpx + constant(safe-area-inset-bottom)); padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); display: flex; gap: 20rpx; box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05); z-index: 100; }
.btn-cancel { flex: 1; min-width: 0; padding: 24rpx; background: #fff; color: #666; border: 2rpx solid #e8e8e8; border-radius: 8rpx; font-size: 32rpx; }
.btn-primary { flex: 1; min-width: 0; padding: 24rpx; background: #6a7cfc; color: #fff; border-radius: 8rpx; font-size: 32rpx; border: none; }

@media (max-width: 360px) {
  .footer { padding-left: 22rpx; padding-right: 22rpx; gap: 14rpx; }
  .btn-cancel,
  .btn-primary { padding: 22rpx 12rpx; font-size: 28rpx; }
  .goods-image { width: 112rpx; height: 112rpx; margin-right: 14rpx; }
}
