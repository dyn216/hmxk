<view class="container">
  <!-- 收货地址 -->
  <view class="address-section" bindtap="selectAddress">
    <view class="address-content" wx:if="{{address}}">
      <view class="address-header">
        <text class="receiver">{{address.name}}</text>
        <text class="phone">{{address.phone}}</text>
      </view>
      <view class="address-detail">{{address.address}}</view>
    </view>
    <view class="address-empty" wx:else>
      <text>请选择收货地址</text>
    </view>
    <text class="arrow">›</text>
  </view>

  <!-- 商品列表 -->
  <view class="goods-section">
    <view class="section-title">商品信息</view>
    <view class="goods-list">
      <view class="goods-item" wx:for="{{items}}" wx:key="id">
        <view class="goods-image icon-product">药</view>
        <view class="goods-info">
          <view class="goods-name">{{item.product.name}}</view>
          <view class="goods-spec">{{item.product.specification}}</view>
          <view class="goods-bottom">
            <text class="price">¥{{item.product.price}}</text>
            <text class="quantity">x{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 处方信息（如果有处方药） -->
  <view class="prescription-section" wx:if="{{hasPrescriptionDrug}}">
    <view class="section-title">处方信息</view>
    <view class="prescription-select" bindtap="selectPrescription">
      <text class="label">选择处方</text>
      <view class="prescription-info" wx:if="{{selectedPrescription}}">
        <text>{{selectedPrescription.diagnosis}}</text>
      </view>
      <text class="placeholder" wx:else>请选择医生开具的处方</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 订单备注 -->
  <view class="remark-section">
    <view class="section-title">订单备注</view>
    <textarea 
      class="remark-input" 
      placeholder="选填，请输入备注信息"
      value="{{remark}}"
      bindinput="onRemarkInput"
      maxlength="200"
    />
  </view>

  <!-- 价格明细 -->
  <view class="price-section">
    <view class="price-row">
      <text class="label">商品总价</text>
      <text class="value">¥{{totalPrice}}</text>
    </view>
    <view class="price-row">
      <text class="label">运费</text>
      <text class="value">¥{{shippingFee}}</text>
    </view>
    <view class="price-row total">
      <text class="label">实付款</text>
      <text class="value">¥{{finalPrice}}</text>
    </view>
  </view>

  <!-- 底部提交 -->
  <view class="footer">
    <view class="total-info">
      <text class="label">合计：</text>
      <text class="price">¥{{finalPrice}}</text>
    </view>
    <button class="btn-submit" bindtap="submitOrder">提交订单</button>
  </view>
</view>
