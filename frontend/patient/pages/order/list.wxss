/* 订单列表页样式 */

.container {
  background: #f5f7fa;
  min-height: 100vh;
  padding-bottom: 160rpx;
  padding-bottom: calc(160rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 状态筛选标签 */
.tabs {
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #6a7cfc;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 4rpx;
  background: #6a7cfc;
  border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
  padding: 0 30rpx;
}

.order-item {
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.order-no {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: #999;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-status {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: bold;
}

.order-status.pending {
  color: #faad14;
}

.order-status.paid {
  color: #52c41a;
}

.order-status.shipped {
  color: #1890ff;
}

.order-status.completed {
  color: #666;
}

.order-status.cancelled {
  color: #999;
}

/* 商品信息 */
.order-goods {
  padding: 24rpx 30rpx;
}

.goods-item {
  display: flex;
  margin-bottom: 20rpx;
}

.goods-item:last-child {
  margin-bottom: 0;
}

.goods-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.goods-spec {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.goods-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.quantity {
  font-size: 24rpx;
  color: #999;
}

/* 订单底部 */
.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.total-price {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.total-price .label {
  font-size: 24rpx;
  color: #666;
  margin-right: 8rpx;
}

.total-price .price {
  font-size: 32rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.order-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
}

.btn-action {
  min-width: 120rpx;
  padding: 12rpx 32rpx;
  background: #6a7cfc;
  color: #fff;
  border-radius: 8rpx;
  font-size: 24rpx;
  border: none;
  box-sizing: border-box;
}

.btn-action.secondary {
  background: #fff;
  color: #6a7cfc;
  border: 2rpx solid #6a7cfc;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 30rpx;
  opacity: 0.5;
}

.empty text {
  font-size: 28rpx;
  color: #999;
}

@media (max-width: 360px) {
  .tabs {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .tab-item {
    font-size: 24rpx;
  }

  .order-list {
    padding-left: 20rpx;
    padding-right: 20rpx;
  }

  .order-header,
  .order-goods,
  .order-footer {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .goods-image {
    width: 112rpx;
    height: 112rpx;
    margin-right: 14rpx;
  }

  .goods-name {
    font-size: 26rpx;
  }

  .order-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .order-actions {
    width: 100%;
  }

  .btn-action {
    flex: 1;
    min-width: 0;
    padding: 14rpx 12rpx;
  }
}
