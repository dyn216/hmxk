<view class="container">
  <!-- 订单状态 -->
  <view class="status-section">
    <view class="status-icon icon-status">订</view>
    <view class="status-text">{{statusText[order.status]}}</view>
    <view class="status-desc" wx:if="{{order.status === 'shipped'}}">
      商品正在配送中，请耐心等待
    </view>
  </view>

  <!-- 收货地址 -->
  <view class="address-section">
    <view class="section-title">收货信息</view>
    <view class="address-info">
      <view class="receiver">
        <text class="name">{{order.receiver_name}}</text>
        <text class="phone">{{order.receiver_phone}}</text>
      </view>
      <view class="address">{{order.receiver_address}}</view>
    </view>
  </view>

  <!-- 商品信息 -->
  <view class="goods-section">
    <view class="section-title">商品信息</view>
    <view class="goods-list">
      <view class="goods-item" wx:for="{{order.items}}" wx:key="id">
        <view class="goods-image icon-product">药</view>
        <view class="goods-info">
          <view class="goods-name">{{item.product.name}}</view>
          <view class="goods-spec">{{item.product.specification}}</view>
          <view class="goods-bottom">
            <text class="price">¥{{item.price}}</text>
            <text class="quantity">x{{item.quantity}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 订单信息 -->
  <view class="order-info-section">
    <view class="section-title">订单信息</view>
    <view class="info-row">
      <text class="label">订单号：</text>
      <text class="value">{{order.order_number}}</text>
    </view>
    <view class="info-row">
      <text class="label">下单时间：</text>
      <text class="value">{{order.created_at}}</text>
    </view>
    <view class="info-row" wx:if="{{order.paid_at}}">
      <text class="label">支付时间：</text>
      <text class="value">{{order.paid_at}}</text>
    </view>
    <view class="info-row" wx:if="{{order.shipped_at}}">
      <text class="label">发货时间：</text>
      <text class="value">{{order.shipped_at}}</text>
    </view>
    <view class="info-row" wx:if="{{order.delivered_at}}">
      <text class="label">送达时间：</text>
      <text class="value">{{order.delivered_at}}</text>
    </view>
  </view>

  <!-- 价格明细 -->
  <view class="price-section">
    <view class="price-row">
      <text class="label">商品总价</text>
      <text class="value">¥{{order.total_amount}}</text>
    </view>
    <view class="price-row">
      <text class="label">运费</text>
      <text class="value">¥0.00</text>
    </view>
    <view class="price-row total">
      <text class="label">实付款</text>
      <text class="value">¥{{order.total_amount}}</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="footer" wx:if="{{order.status === 'pending' || order.status === 'shipped'}}">
    <button 
      class="btn-cancel" 
      wx:if="{{order.status === 'pending'}}"
      bindtap="cancelOrder"
    >取消订单</button>
    <button 
      class="btn-primary" 
      wx:if="{{order.status === 'pending'}}"
      bindtap="payOrder"
    >立即支付</button>
    <button 
      class="btn-primary" 
      wx:if="{{order.status === 'shipped'}}"
      bindtap="confirmReceive"
    >确认收货</button>
  </view>
</view>
