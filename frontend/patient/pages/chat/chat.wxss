/* 聊天页面 - 按HTML原型设计 */
.chat-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 430px;
  height: auto;
  margin-left: auto;
  margin-right: auto;
  background: #F5F5F5;
  z-index: 150;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

/* 聊天头部 */
.chat-header {
  height: 96rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  border-bottom: 1px solid #eee;
  font-weight: bold;
  font-size: 32rpx;
  flex-shrink: 0;
}

.back-btn {
  margin-right: 32rpx;
  font-size: 40rpx;
}

.chat-title {
  flex: 1;
}

/* 消息列表 */
.chat-body {
  flex: 1;
  height: 0;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

.time-divider {
  text-align: center;
  margin: 20rpx 0;
}

.time-divider text {
  background: #ddd;
  color: white;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
}

/* 消息气泡 */
.message {
  display: flex;
  width: 100%;
  margin-bottom: 32rpx;
  align-items: flex-start;
  box-sizing: border-box;
}

.message.self {
  justify-content: flex-end;
}

.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ddd;
  margin-right: 14rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.message.self .msg-avatar {
  order: 2;
  margin-right: 0;
  margin-left: 14rpx;
}

.msg-wrap {
  order: 1;
  max-width: calc(100% - 100rpx);
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.message.self .msg-wrap {
  align-items: flex-end;
}

.msg-content {
  max-width: 100%;
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.4;
  position: relative;
  box-sizing: border-box;
  word-break: break-word;
  white-space: normal;
}

.msg-time {
  max-width: 100%;
  margin-top: 8rpx;
  color: #999;
  font-size: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.msg-text {
  display: block;
  line-height: 1.5;
  word-break: break-word;
  white-space: pre-wrap;
}

.msg-image {
  width: 260rpx;
  height: 260rpx;
  border-radius: 12rpx;
  display: block;
}

.message:not(.self) .msg-content {
  background: #FFFFFF;
  color: #333;
  border-top-left-radius: 0;
}

.message.self .msg-content {
  background: #2C5A52;
  color: white;
  border-top-right-radius: 0;
}

/* 输入栏 */
.chat-input-area {
  min-height: 112rpx;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  border-top: 1px solid #eee;
  flex-shrink: 0;
  box-sizing: border-box;
}

.input-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f2f4f7;
  color: #2C5A52;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.input-box {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border: none;
  border-radius: 36rpx;
  padding: 0 20rpx;
  margin: 0 20rpx;
  font-size: 28rpx;
  min-width: 0;
}

.send-btn {
  width: 112rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
  border-radius: 32rpx;
  background: #2C5A52;
  color: #fff;
  font-size: 26rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.action-panel {
  flex-shrink: 0;
  display: flex;
  gap: 32rpx;
  padding: 28rpx 36rpx;
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.action-item {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #666;
  font-size: 24rpx;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 12rpx;
  border-radius: 20rpx;
  background: #f2f4f7;
  color: #2C5A52;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

@media (max-width: 360px) {
  .chat-header {
    height: 88rpx;
    padding-left: 22rpx;
    padding-right: 22rpx;
    font-size: 30rpx;
  }

  .back-btn {
    margin-right: 22rpx;
  }

  .chat-body {
    padding: 22rpx;
  }

  .msg-avatar {
    width: 64rpx;
    height: 64rpx;
    margin-right: 12rpx;
  }

  .message.self .msg-avatar {
    margin-right: 0;
    margin-left: 12rpx;
  }

  .msg-wrap {
    max-width: calc(100% - 88rpx);
  }

  .msg-content {
    max-width: 100%;
    padding: 18rpx 22rpx;
    font-size: 26rpx;
  }

  .chat-input-area {
    min-height: 100rpx;
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .input-icon {
    width: 56rpx;
    height: 56rpx;
  }

  .input-box {
    height: 64rpx;
    margin-left: 14rpx;
    margin-right: 14rpx;
    font-size: 26rpx;
  }

  .send-btn {
    width: 96rpx;
    height: 60rpx;
    line-height: 60rpx;
    font-size: 24rpx;
  }
}
