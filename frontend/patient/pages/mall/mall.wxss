/* 引入全局样式 */
@import "/styles/common.wxss";

/* 页面全局样式 */
.mall-page {
  padding: 20rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box !important;
}

/* 搜索栏 */
.search-bar {
  display: flex !important;
  align-items: center !important;
  background-color: #fff !important;
  border-radius: 12rpx !important;
  padding: 15rpx 20rpx !important;
  margin-bottom: 30rpx !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05) !important;
}
.search-input {
  flex: 1 !important;
  font-size: 28rpx !important;
  color: #333 !important;
  height: 40rpx !important;
  line-height: 40rpx !important;
}
.search-icon {
  margin-left: 15rpx !important;
}

/* 分类导航 */
.category-scroll {
  white-space: nowrap !important;
  margin-bottom: 30rpx !important;
  padding-bottom: 10rpx !important; /* 防止图标被截断 */
}
.category-item {
  display: inline-flex !important;
  flex-direction: column !important;
  align-items: center !important;
  margin: 0 20rpx !important; /* 统一左右间距 */
  padding: 10rpx 0 !important;
}
.category-icon {
  width: 60rpx !important;
  height: 60rpx !important;
  border-radius: 50% !important;
  margin-bottom: 10rpx !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}
/* 分类图标添加小图标视觉 */
.category-icon.hypertension::after {
  content: '🩸' !important;
  font-size: 30rpx !important;
}
.category-icon.diabetes::after {
  content: '🍬' !important;
  font-size: 30rpx !important;
}
.category-icon.cardio::after {
  content: '❤️' !important;
  font-size: 30rpx !important;
}
.category-icon.common::after {
  content: '💊' !important;
  font-size: 30rpx !important;
}
.category-icon.health::after {
  content: '🌿' !important;
  font-size: 30rpx !important;
}
.category-name {
  font-size: 24rpx !important;
  color: #666 !important;
}
.category-item.active {
  position: relative !important;
}
.category-item.active .category-name {
  color: #6a7cfc !important;
  font-weight: 600 !important;
}
/* 选中分类底部加下划线 */
.category-item.active::after {
  content: '' !important;
  position: absolute !important;
  bottom: 0 !important;
  width: 40rpx !important;
  height: 4rpx !important;
  background-color: #6a7cfc !important;
  border-radius: 2rpx !important;
}
/* 分类图标颜色 */
.category-icon.hypertension {
  background-color: #ffeeee !important;
}
.category-icon.diabetes {
  background-color: #e6f7ff !important;
}
.category-icon.cardio {
  background-color: #f0f9e8 !important;
}
.category-icon.common {
  background-color: #fff0f8 !important;
}
.category-icon.health {
  background-color: #fff8e1 !important;
}

/* 商品列表 - 核心布局优化 */
.goods-list {
  display: flex !important;
  flex-wrap: wrap !important;
  gap: 20rpx !important; /* 行列间距统一 */
  justify-content: flex-start !important; /* 左对齐 */
}
/* 空状态 */
.empty-goods {
  width: 100% !important;
  text-align: center !important;
  padding: 80rpx 0 !important;
  color: #909399 !important;
  font-size: 28rpx !important;
}
/* 商品项 - 精准控制宽度+强制flex布局（解决按钮错位核心） */
.goods-item {
  width: calc((100% - 20rpx) / 2) !important; /* 2列均分 */
  background-color: #fff !important;
  border-radius: 16rpx !important;
  padding: 20rpx !important;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06) !important;
  box-sizing: border-box !important;
  transition: transform 0.2s ease !important;
  /* 强制flex垂直布局 + 相对定位（为按钮绝对定位兜底） */
  display: flex !important;
  flex-direction: column !important;
  position: relative !important;
  min-height: 480rpx !important; /* 固定最小高度，避免内容过少导致按钮上移 */
  padding-bottom: 88rpx !important; /* 为按钮预留固定空间 */
}
/* 商品卡片点击反馈 */
.goods-item:active {
  transform: scale(0.98) !important;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04) !important;
}
/* 商品图片 - 固定比例，避免变形 */
.goods-image {
  width: 100% !important;
  height: 220rpx !important; /* 固定高度 */
  border-radius: 12rpx !important;
  overflow: hidden !important;
  margin: 0 0 15rpx 0 !important; /* 仅保留底部间距 */
  background-color: #f8f8f8 !important; /* 图片加载前占位 */
}
.goods-image image {
  width: 100% !important;
  height: 100% !important;
}
/* 商品信息区 - 占满剩余高度 */
.goods-info {
  display: flex !important;
  flex-direction: column !important;
  flex: 1 !important; /* 占满剩余高度 */
}
.goods-name {
  font-size: 28rpx !important;
  font-weight: 600 !important;
  color: #303133 !important;
  margin: 0 0 8rpx 0 !important;
  display: -webkit-box !important;
  -webkit-line-clamp: 2 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
  line-height: 1.4 !important;
}
.goods-desc {
  font-size: 24rpx !important;
  color: #909399 !important;
  margin: 0 0 12rpx 0 !important;
  display: -webkit-box !important;
  -webkit-line-clamp: 1 !important;
  -webkit-box-orient: vertical !important;
  overflow: hidden !important;
  line-height: 1.3 !important;
}
.goods-price {
  font-size: 32rpx !important;
  font-weight: 600 !important;
  color: #ff6b6b !important;
  margin: 0 0 15rpx 0 !important;
}
/* 加入购物车按钮 - 绝对定位彻底固定位置，解决所有偏移 */
.add-cart-btn {
  position: absolute !important;
  bottom: 20rpx !important; /* 与卡片内边距一致 */
  left: 20rpx !important; /* 与卡片内边距一致 */
  width: calc(100% - 40rpx) !important; /* 卡片宽度 - 左右内边距 */
  background-color: #6a7cfc !important;
  color: #fff !important;
  border-radius: 10rpx !important;
  font-size: 26rpx !important;
  height: 68rpx !important;
  line-height: 68rpx !important;
  margin: 0 !important; /* 清除所有margin */
}
.add-cart-btn::after {
  border: none !important; /* 清除小程序默认button边框 */
}
/* 按钮点击反馈 */
.add-cart-btn:active {
  background-color: #5568e8 !important;
}