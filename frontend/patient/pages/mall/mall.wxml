<view class="mall-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input placeholder="搜索药品名称、病症..." class="search-input" />
    <icon type="search" size="24" color="#999" class="search-icon" />
  </view>

  <!-- 分类导航 -->
  <scroll-view scroll-x class="category-scroll" scroll-with-animation>
    <view class="category-item {{currentCategory === item.id ? 'active' : ''}}" 
          wx:for="{{categories}}" wx:key="id"
          bindtap="switchCategory" data-id="{{item.id}}">
      <view class="category-icon {{item.iconClass}}"></view>
      <view class="category-name">{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 商品列表 -->
  <view class="goods-list">
    <!-- 空状态提示 -->
    <block wx:if="{{currentGoods.length === 0}}">
      <view class="empty-goods">暂无该分类商品</view>
    </block>
    <block wx:else>
      <view class="goods-item" wx:for="{{currentGoods}}" wx:key="id" bindtap="goToGoodsDetail" data-id="{{item.id}}">
        <view class="goods-image">
          <view class="goods-icon icon-product">药</view>
        </view>
        <view class="goods-info">
          <view class="goods-name">{{item.name}}</view>
          <view class="goods-desc">{{item.desc}}</view>
          <view class="goods-price">¥{{item.formattedPrice}}</view>
          <button class="add-cart-btn" catchtap="addToCart" data-id="{{item.id}}">加入购物车</button>
        </view>
      </view>
    </block>
  </view>
</view>
