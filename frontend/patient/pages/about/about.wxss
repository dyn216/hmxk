.about-page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 头部区域 */
.header-section {
  background: linear-gradient(135deg, #6a7cfc 0%, #8b9cff 100%);
  padding: 80rpx 0 100rpx;
  text-align: center;
  position: relative;
}

.about-brand {
  display: flex;
  align-items: center;
  justify-content: center;
}

.app-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(106, 124, 252, 0.3);
}

.app-name {
  display: inline-block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-left: 22rpx;
}

.app-version {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 16rpx;
}

.app-slogan {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 24rpx;
}

/* 功能介绍 */
.feature-section {
  margin-top: -60rpx;
  padding: 0 40rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 32rpx;
  text-align: center;
}

.feature-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.feature-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  background-size: 40rpx 40rpx;
  background-repeat: no-repeat;
  background-position: center;
}

.feature-icon.monitor {
  background-color: #e3f2fd;
}

.feature-icon.ai {
  background-color: #f3e5f5;
}

.feature-icon.reminder {
  background-color: #fff3e0;
}

.feature-icon.doctor {
  background-color: #e8f5e9;
}

.feature-info {
  flex: 1;
}

.feature-name {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
}

.feature-desc {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 信息区域 */
.info-section,
.contact-section {
  margin-top: 40rpx;
  padding: 0 40rpx;
}

.info-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.info-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 24rpx;
  text-align: justify;
}

.info-text:last-child {
  margin-bottom: 0;
}

/* 联系方式 */
.contact-list {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.contact-item {
  display: flex;
  align-items: flex-start;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}

.contact-item:last-child {
  margin-bottom: 0;
}

.contact-label {
  color: #999;
  flex-shrink: 0;
}

.contact-value {
  color: #333;
  flex: 1;
}

/* 法律信息 */
.legal-section {
  margin-top: 60rpx;
  text-align: center;
  padding: 0 40rpx;
}

.legal-links {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.legal-link {
  font-size: 28rpx;
  color: #6a7cfc;
  padding: 8rpx 16rpx;
}

.legal-divider {
  color: #ddd;
  margin: 0 8rpx;
}

.copyright {
  display: block;
  font-size: 24rpx;
  color: #999;
}
