/* 聊天页面样式 */
.consult-chat-page {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  max-width: 430px;
  height: auto;
  margin-left: auto;
  margin-right: auto;
  background: #f5f7fa;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
}

.chat-header {
  height: 112rpx;
  background: #fff;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  flex-shrink: 0;
  box-sizing: border-box;
}

.doctor-info {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.info {
  flex: 1;
  min-width: 0;
}

.info .name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.3;
}

.info .title {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.4;
}

.message-list {
  flex: 1;
  height: 0;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

.message-item {
  display: flex;
  width: 100%;
  margin-bottom: 30rpx;
  align-items: flex-start;
  box-sizing: border-box;
}

.message-item.mine {
  justify-content: flex-end;
}

.message-item .avatar {
  width: 72rpx;
  height: 72rpx;
}

.message-item.mine .avatar {
  order: 2;
  margin-right: 0;
  margin-left: 14rpx;
}

.message-item.other .avatar {
  order: 1;
  margin-right: 14rpx;
}

.message-content {
  max-width: calc(100% - 100rpx);
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.message-item.mine .message-content {
  order: 1;
  align-items: flex-end;
}

.message-item.other .message-content {
  order: 2;
}

.message-bubble {
  display: inline-block;
  max-width: 100%;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
  white-space: pre-wrap;
  box-sizing: border-box;
}

.message-item.mine .message-bubble {
  background: #2C5A52;
  color: #fff;
  border-top-right-radius: 4rpx;
}

.message-item.other .message-bubble {
  background: #fff;
  color: #333;
  border-top-left-radius: 4rpx;
}

.message-image {
  width: 260rpx;
  height: 260rpx;
  border-radius: 12rpx;
  display: block;
}

.image-bubble {
  padding: 8rpx;
}

.message-time {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-item.mine .message-time {
  text-align: right;
}

.input-bar {
  min-height: 112rpx;
  background: #fff;
  padding: 0 24rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.05);
  flex-shrink: 0;
  box-sizing: border-box;
}

.input-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #f2f4f7;
  color: #2C5A52;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.message-input {
  flex: 1;
  height: 72rpx;
  margin: 0 20rpx;
  padding: 0 24rpx;
  background: #f5f7fa;
  border-radius: 36rpx;
  font-size: 28rpx;
  min-width: 0;
}

.btn-send {
  width: 112rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0;
  background: #2C5A52;
  color: #fff;
  border-radius: 32rpx;
  font-size: 26rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.action-panel {
  flex-shrink: 0;
  display: flex;
  gap: 32rpx;
  padding: 28rpx 36rpx;
  padding-bottom: calc(28rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eee;
}

.action-item {
  width: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #666;
  font-size: 24rpx;
}

.action-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 12rpx;
  border-radius: 20rpx;
  background: #f2f4f7;
  color: #2C5A52;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

@media (max-width: 360px) {
  .chat-header {
    height: 100rpx;
    padding-left: 22rpx;
    padding-right: 22rpx;
  }

  .avatar {
    width: 72rpx;
    height: 72rpx;
  }

  .info .name {
    font-size: 30rpx;
  }

  .message-list {
    padding: 22rpx;
  }

  .message-content {
    max-width: calc(100% - 88rpx);
  }

  .message-bubble {
    padding: 18rpx 22rpx;
    font-size: 26rpx;
  }

  .input-bar {
    min-height: 100rpx;
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .input-icon {
    width: 56rpx;
    height: 56rpx;
  }

  .message-input {
    height: 64rpx;
    margin-left: 14rpx;
    margin-right: 14rpx;
    font-size: 26rpx;
  }

  .btn-send {
    width: 96rpx;
    height: 60rpx;
    line-height: 60rpx;
    font-size: 24rpx;
  }
}
