.redirect-page {
  min-height: 100vh;
  background: #FBF8F1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.redirect-card {
  width: 100%;
  padding: 72rpx 40rpx;
  background: #fff;
  border-radius: 28rpx;
  text-align: center;
  box-shadow: 0 18rpx 48rpx rgba(14, 30, 38, 0.08);
}

.redirect-icon {
  margin: 0 auto 28rpx;
}

.redirect-title {
  color: #0E1E26;
  font-size: 34rpx;
  font-weight: 700;
}

.redirect-desc {
  margin-top: 12rpx;
  color: #8E929A;
  font-size: 26rpx;
}
