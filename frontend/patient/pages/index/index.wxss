@import "/styles/common.wxss";

page {
  background-color: var(--paper-soft);
}

/* —— 页眉 —— */
.page-head {
  padding: 36rpx 32rpx 12rpx;
  background: var(--paper-soft);
}

.page-head .eyebrow {
  display: inline-block;
  margin-bottom: 18rpx;
  padding: 8rpx 20rpx;
  border: 1rpx solid var(--hairline);
  border-radius: 999rpx;
  background: var(--paper);
  color: var(--ink-mute);
  font-family: "SF Mono", "Menlo", monospace;
  font-size: 20rpx;
  letter-spacing: 0.32em;
  text-transform: uppercase;
}

.page-head .title {
  display: block;
  font-family: "Source Han Serif SC", "Songti SC", Georgia, serif;
  font-size: 60rpx;
  font-weight: 500;
  letter-spacing: -1.5rpx;
  line-height: 1.12;
  color: var(--ink);
}

.page-head .subtitle {
  display: block;
  margin-top: 14rpx;
  color: var(--ink-soft);
  font-size: 26rpx;
  line-height: 1.7;
}

/* —— Measure card —— */
.measure-card {
  padding: 32rpx 32rpx 28rpx;
}

.input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.input-row:last-child { margin-bottom: 0; }

.input-group {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 28rpx;
  background: var(--paper-soft);
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
}

.input-label {
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-mute);
  white-space: nowrap;
}

.input-field {
  flex: 1;
  font-family: "Source Han Serif SC", "Songti SC", Georgia, serif;
  font-size: 40rpx;
  font-weight: 500;
  letter-spacing: -1rpx;
  color: var(--ink);
  text-align: center;
  min-width: 80rpx;
}

.input-unit {
  font-family: "SF Mono", "Menlo", monospace;
  font-size: 20rpx;
  color: var(--ink-mute);
  letter-spacing: 0.04em;
}

.btn-save {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  background: var(--ink);
  color: var(--paper);
  border-radius: 999rpx;
  border: none;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.08em;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-save:active { background: var(--sage-deep); }
.btn-save::after { border: none; }

/* —— Health tip —— */
.health-tip {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx 26rpx;
  border-radius: 22rpx;
  margin-top: 24rpx;
  border: 1rpx solid var(--hairline);
  animation: slideIn 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
}

@keyframes slideIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.health-tip.tip-normal {
  background: var(--jade-soft);
  border-color: rgba(79, 140, 104, 0.32);
}

.health-tip.tip-warning {
  background: var(--amber-soft);
  border-color: rgba(192, 137, 78, 0.32);
}

.health-tip.tip-danger {
  background: var(--coral-soft);
  border-color: rgba(199, 93, 79, 0.32);
}

.status-elevated { background: var(--amber); }
.status-low { background: #4a90d9; }

.tip-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tip-content { flex: 1; min-width: 0; }

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
  color: var(--ink);
  letter-spacing: -0.5rpx;
}

.tip-desc {
  font-size: 24rpx;
  color: var(--ink-soft);
  line-height: 1.6;
}

@media (max-width: 360px) {
  .page-head {
    padding: 28rpx 24rpx 8rpx;
  }

  .page-head .eyebrow {
    font-size: 18rpx;
    letter-spacing: 0.22em;
  }

  .page-head .title {
    font-size: 50rpx;
  }

  .input-row {
    flex-direction: column;
    gap: 14rpx;
  }

  .input-group {
    padding: 20rpx 22rpx;
  }

  .input-field {
    font-size: 36rpx;
  }

  .btn-save {
    width: 100%;
    height: 88rpx;
  }

  .health-tip {
    padding: 22rpx;
  }
}
